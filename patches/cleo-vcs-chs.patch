diff -ruN pristine/source/core.cpp cleo-src/source/core.cpp
--- a/source/core.cpp	2026-10-08 07:58:28.000000000 +0800
+++ b/source/core.cpp	2026-10-25 10:57:31.989933557 +0800
@@ -591,6 +591,54 @@
 		return true;
 	}
 
+	// Some fan translations replace the game font with a reordered glyph page, so every
+	// character CLEO injects shows up shifted along that page. The shift depends on the
+	// translation, so it is read from cleo.ini:
+	//   text_offset=-2
+	//   text_offset_disc=ULJM05297   (optional: only apply it for this disc id)
+	void read_text_config()
+	{
+		FILE *f = fopen("ms0:/PSP/PLUGINS/cleo/cleo.ini", "rt");
+		if (!f) return;
+
+		int offset = 0;
+		std::string disc_filter;
+		char line[128];
+		while (fgets(line, sizeof(line), f))
+		{
+			char *p = strchr(line, '=');
+			if (!p)
+				continue;
+
+			if (!strncmp(line, "text_offset_disc", 16))
+			{
+				std::string v = p + 1;
+				while (v.size() && (v[v.size() - 1] == '\n' || v[v.size() - 1] == '\r' || v[v.size() - 1] == ' '))
+					v.erase(v.size() - 1);
+				while (v.size() && v[0] == ' ')
+					v.erase(0, 1);
+				disc_filter = v;
+			} else
+			if (!strncmp(line, "text_offset", 11))
+			{
+				offset = atoi(p + 1);
+			}
+		}
+		fclose(f);
+
+		if (!offset)
+			return;
+
+		if (disc_filter.size() && disc_filter != package_name)
+		{
+			utils::log("text_offset: %d skipped, disc is '%s' not '%s'", offset, package_name.c_str(), disc_filter.c_str());
+			return;
+		}
+
+		strutils::ansi_char_offset = offset;
+		utils::log("text_offset: %d", offset);
+	}
+
 	// calls all initializers
 	void initialize()
 	{
@@ -619,6 +667,9 @@
 		package_version_name = libres::getDiscVersion();
 		package_version_code = libres::getDiscVersionCode();
 
+		// optional per-install text adjustment, see "text_offset" in cleo.ini
+		read_text_config();
+
 		// init armhook
 		armhook::init();
 
@@ -1237,6 +1288,18 @@
 			uint32_t add_ib = ScriptParams[1];
 			if (add_ib) addr += image_base;
 
+			// A failed pattern/label lookup (e.g. a script pattern that does not exist in
+			// this particular build of the game) leaves the address at 0, and calling
+			// through it takes the whole emulator down with an execution fault. The game's
+			// code always lives at or above the image base, so anything below it is never
+			// a valid target - stop the offending script instead of jumping into the void.
+			if (addr < 0x08800000u)
+			{
+				utils::log("call_func to invalid address 0x%08X, stopping script '%s'", addr, script.name.c_str());
+				script.invalid = true;
+				return true;
+			}
+
 			int params_i[8];
 			memset(params_i, 0, sizeof(params_i));
 
diff -ruN pristine/source/strutils.cpp cleo-src/source/strutils.cpp
--- a/source/strutils.cpp	2026-10-08 07:58:28.000000000 +0800
+++ b/source/strutils.cpp	2026-10-25 11:09:19.793698345 +0800
@@ -2,6 +2,30 @@
 
 namespace strutils
 {
+	// Some fan translations (e.g. the Chinese VCS port) replace the game font with a
+	// reordered glyph page, so every character CLEO injects ends up showing the glyph
+	// that many positions further along the page. Kept configurable because the shift
+	// depends on the translation; 0 means "unaltered".
+	int ansi_char_offset = 0;
+
+	// When a shift is configured the font only carries a single alphabet block (the
+	// lowercase letter forms, at the top of the range the shift points into), so the
+	// text has to be upper cased first - that is what the game's own strings do too.
+	// The digit block sits one slot closer, so it needs its own adjustment.
+	uint16_t glyph_code(int c)
+	{
+		if (ansi_char_offset)
+		{
+			if (c >= 'a' && c <= 'z')
+				c -= 'a' - 'A';
+			if (c >= '0' && c <= '9')
+				c += ansi_char_offset + 1;
+			else if (c > 0x20)
+				c += ansi_char_offset;
+		}
+		return (uint16_t)c;
+	}
+
 	std::string ansi_from_wstr(uint16_t *w)
 	{
 		std::string res;
@@ -18,7 +42,7 @@
 		wide_string res;
 		while (*a)
 		{
-			res += static_cast<char>(*a);
+			res += static_cast<char>(glyph_code((unsigned char)*a));
 			a++;
 		}
 		return res;
@@ -29,7 +53,7 @@
 		int i = 0;
 		while (a[i])
 		{
-			w[i] = a[i];
+			w[i] = (uint16_t)glyph_code((unsigned char)a[i]);
 			i++;
 		}
 		w[i] = 0;
